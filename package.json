{
  "name": "dsh-h3-image",
  "version": "0.2.8",
  "description": "\u5728 Apple Silicon \u4e0a\u7528\u5f00\u6e90 MiniMax H3-Image\uff08MLX \u5f15\u64ce\uff09\u505a\u5b8c\u5168\u672c\u5730\u6587\u751f\u56fe\u7684 DeepSeek Harness \u63d2\u4ef6\uff1a\u4e00\u952e\u5b89\u88c5\u5411\u5bfc + \u96f6\u51fa\u7f51\u672c\u5730\u751f\u56fe\u3002Fully local MiniMax H3-Image text-to-image on Apple Silicon MLX \u2014 a DeepSeek Harness plugin with a one-time setup wizard and zero-egress generation.",
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "test": "node --test",
    "prepack": "node scripts/check-version-consistency.mjs && node scripts/check-release-safety.mjs",
    "release": "node scripts/check-version-consistency.mjs && node scripts/check-release-safety.mjs && npm pack && node scripts/check-release-safety.mjs --tarball \"$(ls -t *.tgz | head -1)\""
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./LICENSE": "./LICENSE"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "image-generation",
    "text-to-image",
    "mlx",
    "local",
    "minimax",
    "minimax-h3",
    "minimax-h3-image",
    "h3-image"
  ],
  "license": "MIT",
  "author": "aiohow",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiohow/dsh-h3-image.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "homepage": "https://github.com/aiohow/dsh-h3-image#readme",
  "bugs": {
    "url": "https://github.com/aiohow/dsh-h3-image/issues"
  }
}
