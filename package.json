{
  "name": "dsh-h3-image",
  "version": "0.2.13",
  "description": "在 Apple Silicon 上用开源 MiniMax H3-Image（MLX 引擎）做完全本地文生图的 DeepSeek Harness 插件：一键安装向导 + 零出网本地生图。Fully local MiniMax H3-Image text-to-image on Apple Silicon MLX — a DeepSeek Harness plugin with a one-time setup wizard and no network access at generation.",
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "test": "node --test",
    "prepack": "node scripts/check-version-consistency.mjs && node scripts/check-release-safety.mjs",
    "release": "node scripts/check-version-consistency.mjs && node scripts/check-release-safety.mjs && npm pack && node scripts/check-release-safety.mjs --tarball \"$(ls -t *.tgz | head -1)\""
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./LICENSE": "./LICENSE"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "image-generation",
    "text-to-image",
    "mlx",
    "local",
    "minimax",
    "minimax-h3",
    "minimax-h3-image",
    "h3-image"
  ],
  "license": "MIT",
  "author": "aiohow",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiohow/dsh-h3-image.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "homepage": "https://github.com/aiohow/dsh-h3-image#readme",
  "bugs": {
    "url": "https://github.com/aiohow/dsh-h3-image/issues"
  }
}
